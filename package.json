{
  "name": "dsh-pixel-report",
  "version": "0.1.0",
  "description": "Generates a shareable pixel-art battle report card of your DeepSeek Harness agent's day or week: files changed, lines added/removed, commands run, tokens & cost, cache savings, 24h activity chart, and a deterministic rank badge.",
  "keywords": ["dsh", "dsh-plugin", "deepseek-harness", "deepseek", "pixel-art", "report", "stats", "share", "card", "sidebar"],
  "license": "MIT",
  "author": "qinghuidaqzp",
  "repository": { "type": "git", "url": "git+https://github.com/qinghuidaqzp/dsh-pixel-report.git" },
  "homepage": "https://github.com/qinghuidaqzp/dsh-pixel-report#readme",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "client.js", "typert.js", "lib", "locale", "icon.svg", "cordis.patch.yml", "README.md", "README.en.md", "LICENSE"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web" }
  },
  "engines": { "node": ">=22.12.0", "dsh": ">=0.2.0-0 <0.3.0" },
  "scripts": { "test": "node --test test/*.test.js" },
  "dependencies": {
    "zod": "^4.6.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/schemastery": "^3.19.0"
  }
}
